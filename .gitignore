node_modules/
database.sqlite
.env
.DS_Store

# Estado local de herramientas de agente (logs de aprendizaje, telemetria de costos,
# configuracion por maquina). No es codigo de la aplicacion y no aporta al despliegue.
.cursor/
.kiro/
.github/hooks/

# De .claude solo se versionan las skills, que si son del proyecto y le sirven al equipo.
# Queda fuera todo lo demas: learning/ y mcp-usage.jsonl son telemetria, y settings.json
# acumula rutas absolutas de la maquina de cada quien (cache de npx, scratchpad de sesion),
# asi que compartirlo genera conflictos en vez de ayudar.
**/.claude/
!/.claude/
/.claude/*
!/.claude/skills/

# Bytecode de Python (las skills traen scripts .py)
__pycache__/
*.pyc

# Hash de la contrasena en desarrollo local
.auth/

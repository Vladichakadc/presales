PORT=4000
NODE_ENV=development

# Ruta del archivo SQLite. En Railway, apuntar a un volumen persistente, ej. /data/database.sqlite
DATABASE_PATH=./database.sqlite

# Requerido solo para el boton "Sincronizar" (Fase 3). Se obtiene en console.anthropic.com
# (facturacion propia, separada de una suscripcion de Claude).
ANTHROPIC_API_KEY=

# Basic Auth de todo el sitio. Si ambas quedan vacias la proteccion se desactiva, lo cual
# esta bien en local pero NO en produccion: la herramienta publica precios de lista y
# expone /api/sync, que consume la API de Anthropic.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

PORT=4000
NODE_ENV=development

# Ruta del archivo SQLite. En Railway, apuntar a un volumen persistente, ej. /data/database.sqlite
DATABASE_PATH=./database.sqlite

# Requerido solo para el boton "Sincronizar" (Fase 3). Se obtiene en console.anthropic.com
# (facturacion propia, separada de una suscripcion de Claude).
ANTHROPIC_API_KEY=

# Credencial compartida del sitio. Sin AUTH_PASSWORD nadie puede entrar, y en produccion
# el arranque falla a proposito en vez de dejar los precios abiertos al publico.
AUTH_USER=presales
AUTH_PASSWORD=

# Firma de la cookie de sesion. Si se omite se genera una al arrancar y las sesiones se
# cierran en cada reinicio; fijarla las mantiene abiertas entre despliegues.
SESSION_SECRET=

# Carpeta persistente donde se guarda el hash de la contrasena tras un cambio. En Railway
# debe apuntar al volumen (ej. /data/auth). El catalogo sigue siendo efimero y va aparte.
AUTH_STATE_DIR=./.auth
